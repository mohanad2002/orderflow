# Copy this file to ".env" (same folder) for running on your own PC.
# On Render, set these under the service's "Environment" tab instead.
# Never commit the real .env file — it's in .gitignore.

# ── Nextcloud share that holds Order_App.db ──
NC_HOST=nestle.thegood.cloud
NC_TOKEN=
NC_PASSWORD=
DB_FILENAME=Order_App.db

# ── Replacement passwords (8+ chars) ──
# Applied once at startup, only to an account still on its factory
# password (cs123 / fin123). Passwords changed in the app are never touched.
CS_PASSWORD=
FINANCE_PASSWORD=

# ── Optional ──
# SESSION_SECRET=any-long-random-text   (keeps people logged in across restarts)
# PORT=3000
